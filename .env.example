# -------------------------------------------------------
# .env — FASTLabel 提案書作成ツール 設定ファイル
# このファイルを .env にコピーして値を入力してください
# -------------------------------------------------------

# Anthropic API キー (必須)
# https://console.anthropic.com/ で取得できます
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FASTLabel 資料フォルダのパス (任意)
# Docker Compose がこのパスをコンテナにマウントします
# Windows の場合は / 区切りで記述してください
FASTLABEL_DOCS_PATH=C:/Users/oisok/OneDrive/Desktop/Fastlabel
