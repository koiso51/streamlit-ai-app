# -------------------------------------------------------
# .env — 生成AI活用 提案書ジェネレーター 設定ファイル
# このファイルを .env にコピーして値を入力してください
# -------------------------------------------------------

# Anthropic API キー (必須)
# https://console.anthropic.com/ で取得できます
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 自社サービス資料・支援実績フォルダのパス (任意)
# Docker Compose がこのパスをコンテナにマウントします
# Windows の場合は / 区切りで記述してください
REFERENCE_DOCS_PATH=C:/Users/yourname/Documents/proposal-reference-docs
